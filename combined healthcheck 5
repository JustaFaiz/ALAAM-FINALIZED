def _numeric_block_fingerprints(ws, block_size=5, max_cells=200000):
    """Fingerprints contiguous runs of HARDCODED numeric values (not
    formula results - formula cells hold a string starting with '=' and
    fail the isinstance check below, same exclusion logic as the
    Source Classification structured-% check) in both directions:
    along each row and down each column. A block is a sliding window of
    `block_size` consecutive numbers; each window is hashed and added to
    a set. Two sheets sharing several of these fingerprints have almost
    certainly shared the same underlying numbers somewhere - a run of 5
    matching numbers in the same order is not a coincidence.

    This is the one signal formula-tracing can never produce: it works
    even when the numbers were pasted as static values with zero
    formula trail, and it works ACROSS files, not just within one.

    Column-wise runs are derived by transposing a single row-wise scan
    rather than calling ws.iter_cols() a second time - openpyxl's
    read_only worksheets (used here for speed across a whole batch of
    files) don't support iter_cols() at all, so this is the only way to
    get both directions out of one read-only pass.

    max_cells caps how much of a sheet gets scanned, mainly to keep a
    batch scan of many large files from stalling on one huge sheet.
    """
    fingerprints = set()

    def add_run_blocks(run):
        for k in range(len(run) - block_size + 1):
            fingerprints.add(hash(tuple(run[k:k + block_size])))

    def numeric_value(v):
        if isinstance(v, bool):
            return None  # bool is a subclass of int in Python - exclude explicitly
        if isinstance(v, float):
            return round(v, 6)  # avoid float noise (e.g. 0.1+0.2) breaking otherwise-identical blocks
        if isinstance(v, int):
            return v
        return None

    # Single pass over the sheet, row by row, building a 2D grid of
    # numeric-or-None so column runs can be derived from it afterward
    # without a second read.
    grid = []
    cell_count = 0
    for row in ws.iter_rows():
        row_vals = []
        for cell in row:
            cell_count += 1
            if cell_count > max_cells:
                grid.append(row_vals)
                grid = None
                break
            row_vals.append(numeric_value(cell.value))
        if grid is None:
            break
        grid.append(row_vals)

    if not grid:
        return fingerprints

    # Row-wise runs.
    for row_vals in grid:
        run = []
        for v in row_vals:
            if v is not None:
                run.append(v)
            else:
                if run:
                    add_run_blocks(run)
                run = []
        if run:
            add_run_blocks(run)

    # Column-wise runs - pasted data (a copied column of figures) is at
    # least as common as a copied row. Rows can differ in length, so pad
    # with None rather than assuming a rectangular grid.
    width = max((len(r) for r in grid), default=0)
    for col_idx in range(width):
        run = []
        for row_vals in grid:
            v = row_vals[col_idx] if col_idx < len(row_vals) else None
            if v is not None:
                run.append(v)
            else:
                if run:
                    add_run_blocks(run)
                run = []
        if run:
            add_run_blocks(run)

    return fingerprints


def find_cross_file_value_matches(folder_path, excel_filenames, block_size=5, min_shared_blocks=3):
    """Scans every sheet in every given Excel file (all expected to sit
    in folder_path) for numeric block fingerprints, then reports which
    sheets - possibly in DIFFERENT files - share enough blocks to
    suggest one was copy-pasted from (or alongside) the other.

    Uses an inverted index (fingerprint -> which sheets have it) rather
    than comparing every sheet pair directly, since most sheet pairs
    share nothing at all - this keeps it roughly linear in the total
    number of fingerprints rather than quadratic in sheet count.

    Returns dict: (filename, sheet_name) -> sorted list of
    (other_filename, other_sheet_name, shared_block_count), highest
    count first. Only pairs at/above min_shared_blocks appear at all.
    """
    sheet_fingerprints = {}
    for fname in excel_filenames:
        fpath = os.path.join(folder_path, fname)
        try:
            wb = load_workbook(fpath, data_only=False, read_only=True)
            for ws in wb.worksheets:
                fps = _numeric_block_fingerprints(ws, block_size=block_size)
                if fps:
                    sheet_fingerprints[(fname, ws.title)] = fps
            wb.close()
        except Exception:
            continue  # a bad/corrupt file shouldn't stop the rest of the batch

    inverted = {}
    for key, fps in sheet_fingerprints.items():
        for fp in fps:
            inverted.setdefault(fp, []).append(key)

    pair_counts = {}
    for fp, keys in inverted.items():
        if len(keys) < 2:
            continue
        for i in range(len(keys)):
            for j in range(i + 1, len(keys)):
                a, b = keys[i], keys[j]
                if a == b:
                    continue
                pair = (a, b) if a < b else (b, a)
                pair_counts[pair] = pair_counts.get(pair, 0) + 1

    matches = {}
    for (a, b), count in pair_counts.items():
        if count >= min_shared_blocks:
            matches.setdefault(a, []).append((b[0], b[1], count))
            matches.setdefault(b, []).append((a[0], a[1], count))

    for key in matches:
        matches[key].sort(key=lambda x: -x[2])

    return matches


# ---------------------------------------------------------------
# Cross-file formula flow (file-to-file, based on external workbook
# references in cell formulas - a genuinely different signal from the
# value-overlap fingerprinting above, which infers likely relationships
# from shared numbers with no formula link at all. Formula-based edges
# here are "solid arrow" real, direct connections; a later pass can add
# value-overlap connections as dashed/inferred edges on the same map.
# ---------------------------------------------------------------

EXTERNAL_REF_RE = re.compile(
    r"'\[(\d+)\][^'!]*'!"       # quoted form:   '[1]Sheet Name'!A1
    r"|\[(\d+)\][A-Za-z_][A-Za-z0-9_.]*!"  # unquoted form: [1]Sheet1!A1
)
# Deliberately requires a trailing '!' - that's what a real external-workbook
# cell reference always has and a Table structured reference (e.g.
# Table1[2023] for a year-named column, common in tax workpapers) never
# does, so this excludes structured refs without needing to special-case
# them. Trade-off: external references to a NAMED RANGE with no sheet/'!'
# (e.g. [1]MyDefinedName) are rare and intentionally not matched here.

_OOXML_MAIN_NS = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
_OOXML_R_NS = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}"
_OOXML_PKG_REL_NS = "{http://schemas.openxmlformats.org/package/2006/relationships}"


def extract_external_link_targets(path):
    """Resolves Excel's internal external-workbook reference index (the
    [1], [2], ... that shows up in a formula like '[1]Sheet1'!A1) to the
    actual external file NAME it points to. This isn't in the formula
    text itself - it takes three hops through the xlsx's own zip/XML
    package structure:
      1. xl/workbook.xml <externalReferences> - ordered list of r:id's,
         position in the list = the [N] index used in formulas.
      2. xl/_rels/workbook.xml.rels - r:id -> xl/externalLinks/externalLinkN.xml
      3. xl/externalLinks/_rels/externalLinkN.xml.rels - the actual
         Target (the external file's path/name, exactly as Excel last
         recorded it - which may be an absolute path, a relative path,
         or a file:// URL depending on how the link was created).

    Returns {index: filename} using just the basename (decoded from any
    %20-style escaping) - matching is done by name against files in the
    scanned folder, not by resolving the full original path, since that
    path was almost always written on a different machine than this one.
    """
    targets = {}
    try:
        with zipfile.ZipFile(path) as z:
            names = z.namelist()
            if "xl/workbook.xml" not in names or "xl/_rels/workbook.xml.rels" not in names:
                return targets

            wb_root = ET.parse(z.open("xl/workbook.xml")).getroot()
            ext_refs = wb_root.findall(
                f".//{_OOXML_MAIN_NS}externalReferences/{_OOXML_MAIN_NS}externalReference"
            )
            rids_in_order = [er.get(f"{_OOXML_R_NS}id") for er in ext_refs]
            if not rids_in_order:
                return targets

            rels_root = ET.parse(z.open("xl/_rels/workbook.xml.rels")).getroot()
            rid_to_link_target = {}
            for rel in rels_root.findall(f"{_OOXML_PKG_REL_NS}Relationship"):
                rid_to_link_target[rel.get("Id")] = rel.get("Target")

            for idx, rid in enumerate(rids_in_order, start=1):
                link_target = rid_to_link_target.get(rid)  # e.g. "externalLinks/externalLink1.xml"
                if not link_target:
                    continue
                link_basename = os.path.basename(link_target)
                link_rels_path = f"xl/externalLinks/_rels/{link_basename}.rels"
                if link_rels_path not in names:
                    continue
                link_rels_root = ET.parse(z.open(link_rels_path)).getroot()
                for rel in link_rels_root.findall(f"{_OOXML_PKG_REL_NS}Relationship"):
                    tgt = rel.get("Target", "")
                    if tgt:
                        decoded = urllib.parse.unquote(tgt)
                        targets[idx] = os.path.basename(decoded.replace("\\", "/"))
                        break
    except Exception:
        pass
    return targets


def build_cross_file_formula_graph(folder_path, excel_filenames):
    """Scans every workbook in the folder for formulas that reference an
    EXTERNAL workbook (Excel's own [N] index syntax), resolves each [N]
    to a real file name via extract_external_link_targets, and - only
    when that file name matches another file actually present in this
    same folder - records a file-to-file edge.

    Matching tries an EXACT filename first, then falls back to matching
    by filename STEM (name without extension) if exactly one file in the
    folder shares that stem - this covers the common case where a link
    was created against a .xlsm and the file was later saved as .xlsx
    (or vice versa), which otherwise looks identical to a genuinely
    missing file. If more than one file shares the stem, it's left
    unresolved rather than guessing which one.

    Edge direction follows the same convention as the sheet-to-sheet
    flow elsewhere in this dashboard: (source_file, dest_file), meaning
    data flows FROM source INTO dest (dest's formula is the one doing
    the pulling).

    Returns (edges, skipped, unresolved):
      edges      - {(src_file, dst_file): formula_cell_count}
      skipped    - total count of external-ref formula cells that didn't
                    resolve to a file in this folder
      unresolved - {display_name: count} breakdown of WHY - either the
                    actual external file name Excel recorded (so you can
                    see if it's a rename/extension mismatch or a
                    genuinely different file), or "(index [N] not found
                    in <file>'s external link list)" if the [N] itself
                    couldn't be resolved at all - shown so you're not
                    just staring at one opaque number.
    """
    filenames_in_folder = {f.lower(): f for f in excel_filenames}
    filenames_by_stem = {}
    for f in excel_filenames:
        stem = os.path.splitext(f)[0].lower()
        filenames_by_stem.setdefault(stem, []).append(f)

    edges = {}
    skipped = 0
    unresolved = {}

    for fname in excel_filenames:
        fpath = os.path.join(folder_path, fname)
        try:
            targets = extract_external_link_targets(fpath)
            if not targets:
                continue
            formulas, _, _, _ = load_workbook_data(fpath)
        except Exception:
            continue

        for (sheet, cell), f in formulas.items():
            for m in EXTERNAL_REF_RE.finditer(f):
                idx = int(m.group(1) or m.group(2))
                ext_name = targets.get(idx)
                if not ext_name:
                    label = f"(index [{idx}] not found in {fname}'s external link list)"
                    unresolved[label] = unresolved.get(label, 0) + 1
                    skipped += 1
                    continue

                match = filenames_in_folder.get(ext_name.lower())
                if not match:
                    stem = os.path.splitext(ext_name)[0].lower()
                    candidates = filenames_by_stem.get(stem, [])
                    if len(candidates) == 1:
                        match = candidates[0]

                if not match or match == fname:
                    unresolved[ext_name] = unresolved.get(ext_name, 0) + 1
                    skipped += 1
                    continue

                key = (match, fname)
                edges[key] = edges.get(key, 0) + 1

    return edges, skipped, unresolved


