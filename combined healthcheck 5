def build_manual_stage_tree_html(flow, manual_stages, sheet_names, min_cells=1):
    """Builds the sheet-flow tree colored by your CONFIRMED manual
    classification - your own domain judgment on Input/Process/Output
    for each sheet, treated as ground truth. Flow EDGES are still the
    real, actual formula references between sheets, same as the regular
    tree visual. Confirmed sheets render with a solid white border and
    bold label so the ground truth reads as solid/certain at a glance.
    Sheets never classified (shouldn't normally reach here since this
    is only called post-confirmation, but kept as a safety net) render
    muted with a dashed border to visually mark them as not confirmed."""
    strong_flow = {k: v for k, v in flow.items() if v >= min_cells}

    all_sheets = set(sheet_names)
    for src, dst in strong_flow:
        all_sheets.add(src)
        all_sheets.add(dst)

    nodes = []
    for sheet in all_sheets:
        if sheet in manual_stages:
            stage = manual_stages[sheet]
            color = VALIDATED_STAGE_COLORS.get(stage, UNVALIDATED_COLOR)
            title = f"{sheet}\\nStage: {stage} (confirmed)"
            nodes.append({
                "id": sheet,
                "label": sheet,
                "shape": "box",
                "title": title,
                "color": {
                    "background": color,
                    "border": "#ffffff",
                    "highlight": {"background": color, "border": "#ffffff"},
                },
                "borderWidth": 3,
                "font": {"color": "#ffffff", "bold": True},
            })
        else:
            title = f"{sheet}\\nNot classified"
            nodes.append({
                "id": sheet,
                "label": sheet,
                "shape": "box",
                "title": title,
                "color": {"background": UNVALIDATED_COLOR, "border": "#666666"},
                "borderWidth": 1,
                "shapeProperties": {"borderDashes": [4, 3]},
            })

    edges = []
    for (src, dst), count in strong_flow.items():
        edges.append({"from": src, "to": dst, "label": str(count), "title": f"{count} formula cells"})

    return VALIDATED_TREE_HTML_TEMPLATE.replace("__NODES__", json.dumps(nodes)).replace("__EDGES__", json.dumps(edges))


