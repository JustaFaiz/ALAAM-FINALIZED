def write_temp_file(tmp_dir, filename, data_bytes):
    """Writes data_bytes to tmp_dir/filename - but ONLY if that exact
    path doesn't already hold identical content. Streamlit reruns the
    whole script on every widget interaction (including each drag in
    Manual Classification), so without this check the app would try to
    rewrite the same unchanged workbook dozens of times per session.

    If a write IS actually needed and the target path turns out to be
    locked - most commonly because you have the SAME file open in Excel
    to refer to it while working in the dashboard, which is a completely
    reasonable thing to want to do - this falls back to a content-hashed
    filename instead of raising. The fallback name is deterministic
    (same bytes -> same fallback path), so an unchanged file stays on
    the same fallback path across reruns too, and the "skip if already
    identical" check above still applies to it on the next rerun.

    Returns the path actually holding the content, for the caller to
    read from downstream."""
    target = os.path.join(tmp_dir, filename)
    digest = hashlib.md5(data_bytes).hexdigest()[:10]

    def _matches(path):
        try:
            with open(path, "rb") as f:
                return f.read() == data_bytes
        except (PermissionError, OSError):
            return False  # can't even read it back right now - don't trust it

    if os.path.exists(target) and _matches(target):
        return target  # already there, unchanged - nothing to do

    try:
        with open(target, "wb") as f:
            f.write(data_bytes)
        return target
    except (PermissionError, OSError):
        stem, ext = os.path.splitext(filename)
        fallback = os.path.join(tmp_dir, f"{stem}_{digest}{ext}")
        if os.path.exists(fallback) and _matches(fallback):
            return fallback
        with open(fallback, "wb") as f:
            f.write(data_bytes)
        return fallback


def main():
