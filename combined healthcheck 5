def build_business_flow_html(flow, manual_stages, sheet_names):
    """Builds the BUSINESS flow map: takes the real formula-flow edges
    (r['flow']) and your CONFIRMED manual classification (from the
    dropdown/drag-and-drop above), and keeps only the edges whose
    (source role, destination role) pair is in
    BUSINESS_FLOW_ALLOWED_TRANSITIONS. Roles come ONLY from the
    confirmed classification - never re-derived from the graph - so a
    sheet like an output summary that happens to have one stray inbound
    tie-out cell still renders as Output, not Process.

    Returns (html, skipped):
      html    - vis-network HTML ready to write to disk, or None if no
                edges passed the filter.
      skipped - dict with 'unclassified_sheet' and 'disallowed_transition'
                counts, so you can see how many real formula links were
                excluded and why.
    """
    edges = []
    skipped = {"unclassified_sheet": 0, "disallowed_transition": 0}

    for (src, dst), count in flow.items():
        src_role = manual_stages.get(src)
        dst_role = manual_stages.get(dst)

        if src_role is None or dst_role is None:
            skipped["unclassified_sheet"] += 1
            continue

        if (src_role, dst_role) not in BUSINESS_FLOW_ALLOWED_TRANSITIONS:
            skipped["disallowed_transition"] += 1
            continue

        edges.append((src, dst, count))

    if not edges:
        return None, skipped

    nodes_in_graph = set()
    for src, dst, count in edges:
        nodes_in_graph.add(src)
        nodes_in_graph.add(dst)

    nodes = []
    for sheet in nodes_in_graph:
        stage = manual_stages.get(sheet, "Process")
        color = VALIDATED_STAGE_COLORS.get(stage, UNVALIDATED_COLOR)
        nodes.append({
            "id": sheet,
            "label": sheet,
            "shape": "box",
            "title": f"{sheet}\\n{stage} (confirmed)",
            "color": {"background": color, "border": "#ffffff"},
            "borderWidth": 3,
            "font": {"color": "#ffffff", "bold": True},
        })

    vis_edges = [
        {"from": src, "to": dst, "label": str(count), "title": f"{count} formula cells"}
        for src, dst, count in edges
    ]

    html = BUSINESS_FLOW_HTML_TEMPLATE.replace("__NODES__", json.dumps(nodes)).replace("__EDGES__", json.dumps(vis_edges))
    return html, skipped


def derive_connectivity_stage(sheet_names, flow):
    """Classifies each sheet by CONNECTIVITY ALONE (same signal the tree
    visual uses for root/leaf/middle coloring) - completely independent
    of the structured-%-based Source Classification:
    - Input:    feeds other sheets, nothing feeds it
    - Process:  both receives from and feeds into other sheets
    - Output:   receives from other sheets, feeds nothing further
    - Isolated: no cross-sheet connections at all
    Returns a dict: sheet_name -> stage."""
    has_incoming = set()
    has_outgoing = set()
    for src, dst in flow:
        has_outgoing.add(src)
        has_incoming.add(dst)

    stages = {}
    for sheet in sheet_names:
        incoming = sheet in has_incoming
        outgoing = sheet in has_outgoing
        if incoming and outgoing:
            stages[sheet] = "Process"
        elif outgoing and not incoming:
            stages[sheet] = "Input"
        elif incoming and not outgoing:
            stages[sheet] = "Output"
        else:
            stages[sheet] = "Isolated"
    return stages


def check_isolated_sheets(sheet_names, flow):
    connected = set()
    for src, dst in flow:
        connected.add(src)
        connected.add(dst)
    return [s for s in sheet_names if s not in connected]


def check_pdf(path):
    """Lightweight PDF health check - not trying to apply Excel-style
    concepts (broken formulas etc don't exist for PDFs). Just: is it
    actually readable, how many pages, and does it have a real text
    layer at all - a scanned image with no extractable text matters a
    lot for anything downstream trying to process it automatically."""
    try:
        from pypdf import PdfReader
        reader = PdfReader(path)
        num_pages = len(reader.pages)
        has_text = False
        for page in reader.pages[:5]:  # sample first 5 pages, not every page - just need a signal
            if (page.extract_text() or "").strip():
                has_text = True
                break
        encrypted = reader.is_encrypted
        return {"readable": True, "pages": num_pages, "has_text": has_text,
                "encrypted": encrypted, "error": ""}
    except Exception as e:
        return {"readable": False, "pages": 0, "has_text": False,
                "encrypted": False, "error": str(e)}


def _file_fingerprint(path):
    """(mtime, size) for a file - passed into the cached scan functions
    below as part of the cache key, so a file that hasn't changed since
    the last scan returns instantly from cache, and a file that HAS
    changed (different mtime/size) is correctly treated as a cache miss
    and re-scanned. Purely a cache-invalidation signal, not used for
    anything else."""
    stat = os.stat(path)
    return (stat.st_mtime, stat.st_size)


