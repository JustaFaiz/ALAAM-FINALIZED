    for src, dst in edges:
        nodes_in_graph.add(src)
        nodes_in_graph.add(dst)

    nodes = [
        {
            "id": name, "label": name, "shape": "box",
            "color": {"background": "#2a9d8f", "border": "#ffffff"},
            "borderWidth": 2,
            "title": name,
        }
        for name in sorted(nodes_in_graph)
    ]

    vis_edges = [
        {"from": src, "to": dst, "label": str(count), "title": f"{count} formula cell(s) reference this file"}
        for (src, dst), count in edges.items()
    ]

    return CROSS_FILE_FLOW_HTML_TEMPLATE.replace("__NODES__", json.dumps(nodes)).replace("__EDGES__", json.dumps(vis_edges))


