def build_cross_file_flow_html(edges):
    """Renders the file-to-file formula graph. All edges here are the
    'solid arrow' real, direct kind (an actual formula in one file
    pulling from another) - there is no dashed/inferred edge type yet,
    that's the planned next step once value-overlap edges are layered
    in on top of this same node set."""
    if not edges:
        return None

