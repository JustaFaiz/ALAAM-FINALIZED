        if not cross_matches:
            st.write("No cross-file (or cross-sheet) value matches found at the current sensitivity.")
        else:
            rows = []
            seen_pairs = set()
            for (fname, sheet), matches in cross_matches.items():
                for other_fname, other_sheet, count in matches:
                    pair = tuple(sorted([(fname, sheet), (other_fname, other_sheet)]))
                    if pair in seen_pairs:
                        continue  # each match appears twice (both directions) - show it once
                    seen_pairs.add(pair)
                    rows.append({
                        "Sheet": sheet, "File": fname,
                        "Likely Matches": other_sheet, "In File": other_fname,
                        "Matching Runs": count,
