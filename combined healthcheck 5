        )

        if use_simple_picker:
            # Seed the three multiselects ONCE from whatever's currently
            # held (drag-and-drop state, or a previous run of this picker),
            # so switching modes mid-session doesn't lose existing work.
            # Only seeds if the key doesn't exist yet - after that, the
            # widgets own their state via session_state directly.
            current_stage = {}
            for container in st.session_state[state_key]:
                for sheet in container["items"]:
                    current_stage[sheet] = container["header"]

            for stage in ("Input", "Process", "Output"):
                mkey = f"manual_stage_multiselect_{stage}"
                if mkey not in st.session_state:
                    st.session_state[mkey] = [s for s in sheet_names if current_stage.get(s) == stage]

            # Each stage's OPTIONS exclude sheets already claimed by the
            # other two (read fresh each rerun) - this is what keeps a
            # sheet from ending up in more than one bucket at once: it
            # simply isn't offered in a multiselect's dropdown once it's
            # picked somewhere else, rather than needing to detect and
            # resolve a conflict after the fact.
            input_sel_prev = st.session_state.get("manual_stage_multiselect_Input", [])
            process_sel_prev = st.session_state.get("manual_stage_multiselect_Process", [])
            output_sel_prev = st.session_state.get("manual_stage_multiselect_Output", [])

            input_sel = st.multiselect(
                "Input sheets",
                options=[s for s in sheet_names if s not in set(process_sel_prev) | set(output_sel_prev)],
                key="manual_stage_multiselect_Input",
            )
            process_sel = st.multiselect(
                "Process sheets",
                options=[s for s in sheet_names if s not in set(input_sel_prev) | set(output_sel_prev)],
                key="manual_stage_multiselect_Process",
            )
            output_sel = st.multiselect(
                "Output sheets",
                options=[s for s in sheet_names if s not in set(input_sel_prev) | set(process_sel_prev)],
                key="manual_stage_multiselect_Output",
            )

            assigned = set(input_sel) | set(process_sel) | set(output_sel)
            unclassified_sel = [s for s in sheet_names if s not in assigned]
            if unclassified_sel:
                st.caption(f"{len(unclassified_sel)} sheet(s) still Unclassified: {', '.join(sorted(unclassified_sel))}")

            # Rebuilt into the same container shape the drag-and-drop widget
            # produces, so everything downstream (Confirm Classification,
            # the flow map builders) works identically either way.
            st.session_state[state_key] = [
                {"header": "Unclassified", "items": unclassified_sel},
                {"header": "Input", "items": input_sel},
                {"header": "Process", "items": process_sel},
                {"header": "Output", "items": output_sel},
            ]
            sorted_result = st.session_state[state_key]
        else:
            sorted_result = sort_items(
                st.session_state[state_key],
                multi_containers=True,
                direction="vertical",
                key="manual_classification_sortable",
            )
            st.session_state[state_key] = sorted_result

        if st.button("Confirm Classification", type="primary"):
            manual_map = {}
            unclassified_count = 0
            for container in sorted_result:
                bucket = container["header"]
                items = container["items"]
                if bucket == "Unclassified":
                    unclassified_count = len(items)
                    continue
                for sheet in items:
                    manual_map[sheet] = bucket

            if not manual_map:
                shell_box("No sheets classified yet - drag at least one sheet into Input, Process, or Output before confirming.", ok=False)
            else:
                st.session_state["manual_confirmed_stages"] = manual_map
                st.session_state["manual_confirmed"] = True
                st.session_state["manual_unclassified_count"] = unclassified_count

        if st.session_state.get("manual_confirmed"):
            confirmed = st.session_state["manual_confirmed_stages"]
            shell_box(f"Classification confirmed - {len(confirmed)} sheet(s) locked in as ground truth.", ok=True)

            # Solid display of the confirmed I/P/O - this is the actual
            # answer, shown plainly before anything else happens with it.
            stage_groups = {"Input": [], "Process": [], "Output": []}
            for sheet, stage in confirmed.items():
                stage_groups.setdefault(stage, []).append(sheet)

            conf_col1, conf_col2, conf_col3 = st.columns(3)
            for col, stage in zip((conf_col1, conf_col2, conf_col3), ("Input", "Process", "Output")):
                with col:
                    st.markdown(f"**{stage} ({len(stage_groups.get(stage, []))})**")
                    if stage_groups.get(stage):
                        for s in sorted(stage_groups[stage]):
                            st.write(f"- {s}")
                    else:
                        st.caption("None")

            unclassified_ct = st.session_state.get("manual_unclassified_count", 0)
            if unclassified_ct:
                st.caption(f"({unclassified_ct} sheet(s) still Unclassified - not included in the confirmed set above. Drag them into a bucket and re-confirm if they should be included.)")

            st.divider()

            if st.button("Compare Classifications"):
                connectivity_stage = r.get("connectivity_stage", {})
                source_stage = {}
                if "source_candidates" in st.session_state:
                    for name, stage, fed, pct, sc_count, unsc_count, vol, ext in st.session_state["source_candidates"]:
                        source_stage[name] = stage

                comparison_rows = []
                conn_matches = 0
                src_matches = 0
                compared_count = 0
                for sheet, manual_stage in confirmed.items():
                    conn = connectivity_stage.get(sheet, "?")
                    src = source_stage.get(sheet, "(not run)")
                    conn_match = (conn == manual_stage)
                    src_match = (src == manual_stage) if src != "(not run)" else None
                    if conn_match:
                        conn_matches += 1
                    if src_match:
                        src_matches += 1
                    if src != "(not run)":
                        compared_count += 1
                    comparison_rows.append({
                        "Sheet": sheet,
                        "Manual": manual_stage,
                        "Connectivity-Based": conn,
                        "Connectivity Match": "Yes" if conn_match else "No",
                        "Source Classification": src,
                        "Source Match": ("Yes" if src_match else "No") if src_match is not None else "-",
                    })

                if comparison_rows:
                    st.dataframe(comparison_rows, use_container_width=True)
                    total = len(comparison_rows)
                    conn_pct = round(conn_matches / total * 100, 1) if total else 0
                    shell_box(f"Connectivity-based classification matched manual for {conn_matches}/{total} sheets ({conn_pct}%)", ok=(conn_pct >= 70))
                    if compared_count:
                        src_pct = round(src_matches / compared_count * 100, 1)
                        shell_box(f"Source Classification matched manual for {src_matches}/{compared_count} sheets ({src_pct}%)", ok=(src_pct >= 70))
                    else:
                        shell_box("Source Classification hasn't been run yet - run it above to include it in this comparison.", ok=True)

            # Flow mapping - only reachable after Confirm Classification
            # has been clicked above. Uses the CONFIRMED map, not
            # whatever is currently sitting in the drag-and-drop boxes,
            # so the visual always reflects the locked-in ground truth.
            if "flow" in r:
                if st.button("Build Sheet Flow Visual (Manual Stages)"):
                    html = build_manual_stage_tree_html(r["flow"], confirmed, sheet_names)
                    out_path = os.path.join(tmp_dir, "manual_stage_tree.html")
                    with open(out_path, "w", encoding="utf-8") as f:
                        f.write(html)
                    webbrowser.open(f"file:///{out_path}")
                    shell_box("Opened the visual in a new browser tab.", ok=True)

                st.caption("Locked Input -> Process -> Output columns, showing only the real formula-flow path(s) from a confirmed Input to a confirmed Output.")
                if st.button("Open Input \u2192 Output Flow Map"):
                    html, error = build_staged_flow_html(r["flow"], confirmed, sheet_names)
                    io_out_path = os.path.join(tmp_dir, "input_output_flow_map.html")
                    if html is None:
                        html = NO_PATH_HTML_TEMPLATE.replace("__MESSAGE__", error)
                        with open(io_out_path, "w", encoding="utf-8") as f:
                            f.write(html)
                        webbrowser.open(f"file:///{io_out_path}")
                        shell_box(error, ok=False)
                    else:
                        with open(io_out_path, "w", encoding="utf-8") as f:
                            f.write(html)
                        webbrowser.open(f"file:///{io_out_path}")
                        shell_box("Opened the Input \u2192 Output flow map in a new browser tab.", ok=True)

                st.caption("Business flow: only Input\u2192Process, Process\u2192Process, Process\u2192Output, and Input\u2192Output links - drops tie-outs, backflow, and anything touching an unclassified sheet.")
                if st.button("Open Business Flow Map"):
                    html, skipped = build_business_flow_html(r["flow"], confirmed, sheet_names)
                    bf_out_path = os.path.join(tmp_dir, "business_flow_map.html")
                    if html is None:
                        msg = (
                            "No formula links match an allowed business-flow transition "
                            "(Input\u2192Process, Process\u2192Process, Process\u2192Output, Input\u2192Output) "
                            "between confirmed sheets yet."
                        )
                        html = NO_PATH_HTML_TEMPLATE.replace("__MESSAGE__", msg)
                        with open(bf_out_path, "w", encoding="utf-8") as f:
                            f.write(html)
                        webbrowser.open(f"file:///{bf_out_path}")
                        shell_box(msg, ok=False)
                    else:
                        with open(bf_out_path, "w", encoding="utf-8") as f:
                            f.write(html)
                        webbrowser.open(f"file:///{bf_out_path}")
                        shell_box(
                            f"Opened the Business Flow Map - {skipped['unclassified_sheet']} link(s) skipped "
                            f"(unclassified sheet), {skipped['disallowed_transition']} link(s) skipped "
                            f"(not a business-flow transition).",
                            ok=True,
                        )
        else:
            st.info("Drag sheets into Input, Process, or Output above, then click **Confirm Classification** to lock it in. Flow mapping unlocks after that.")
    else:
        st.caption("Run Health Check above first so sheet names are available to classify.")

    def build_report_text():
        BAR = "=" * 78
        DASH = "-" * 78
        lines = []

        lines.append(BAR)
        lines.append("EXCEL WORKBOOK HEALTH CHECK REPORT")
        lines.append(BAR)
        lines.append(f"Workbook:  {uploaded.name}")
        lines.append(f"Generated: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        lines.append(f"{r['formulas']} formulas across {r['sheets']} sheets")
        lines.append("")

        # --- Health Check section ---
        lines.append(DASH)
        lines.append("HEALTH CHECK")
        lines.append(DASH)
        lines.append("")

        lines.append(f"Broken Links ({len(r['breaks'])})")
        if r["breaks"]:
            for s, c, f in r["breaks"]:
                lines.append(f"  - {s}!{c} : {f}")
        else:
            lines.append("  None found.")
        lines.append("")

        lines.append(f"Circular References ({len(r['cycles'])})")
        if r["cycles"]:
            for cyc in r["cycles"]:
                lines.append("  - " + " -> ".join(f"{s}!{c}" for s, c in cyc))
        else:
            lines.append("  None found.")
        lines.append("")

        lines.append(f"Isolated Sheets ({len(r['isolated'])})")
        if r["isolated"]:
            for s in r["isolated"]:
                lines.append(f"  - {s}")
        else:
            lines.append("  None - every sheet is connected to the flow.")
        lines.append("")

        lines.append(f"Hidden Sheets ({len(r['hidden'])})")
        if r["hidden"]:
            for s, state in r["hidden"]:
                lines.append(f"  - {s} ({state})")
        else:
            lines.append("  None found.")
        lines.append("")

        lines.append(f"External Data Connections ({len(r['connections'])})")
        if r["connections"]:
            for name, ctype, detail in r["connections"]:
                lines.append(f"  - {name} ({ctype}): {detail}")
        else:
            lines.append("  None found.")
        lines.append("")

        # --- Confirmed Manual Classification section (only if confirmed) ---
        if st.session_state.get("manual_confirmed"):
            confirmed = st.session_state["manual_confirmed_stages"]
            stage_groups = {"Input": [], "Process": [], "Output": []}
            for sheet, stage in confirmed.items():
                stage_groups.setdefault(stage, []).append(sheet)

            lines.append(DASH)
            lines.append("CONFIRMED CLASSIFICATION (MANUAL, GROUND TRUTH)")
            lines.append(DASH)
            lines.append("")
            for stage in ("Input", "Process", "Output"):
                sheets_in_stage = sorted(stage_groups.get(stage, []))
                lines.append(f"{stage} ({len(sheets_in_stage)})")
                if sheets_in_stage:
                    for s in sheets_in_stage:
                        lines.append(f"  - {s}")
                else:
                    lines.append("  None.")
                lines.append("")
        else:
            lines.append(DASH)
            lines.append("CONFIRMED CLASSIFICATION (MANUAL, GROUND TRUTH)")
            lines.append(DASH)
            lines.append("(Not confirmed yet - use the Manual Classification section above to lock it in.)")
            lines.append("")

        # --- Source Classification section (only if it's been run) ---
        if "source_candidates" in st.session_state:
            sc = st.session_state["source_candidates"]
            # Stage list comes from the classifier module itself (saved
            # when Source Classification was run), not a second hardcoded
            # copy here - see comment above the "Run Source Classification"
            # button for why. Falls back to whatever stages actually show
            # up in the results if that wasn't saved for some reason, so
            # this section can't itself throw a KeyError on an unknown stage.
            stage_order = st.session_state.get("source_stage_order")
            if stage_order:
                stage_counts = {stage: 0 for stage in stage_order}
            else:
                stage_counts = {}
            for _, stage, _, _, _, _, _, _ in sc:
                stage_counts[stage] = stage_counts.get(stage, 0) + 1

            lines.append(DASH)
            lines.append("SOURCE CLASSIFICATION")
            lines.append(DASH)
            lines.append("")
            summary_parts = [f"{count} {stage}" for stage, count in stage_counts.items() if count > 0]
            lines.append(f"{len(sc)} sheet(s) total: " + ", ".join(summary_parts))
            lines.append("")

            col_widths = (22, 15, 9, 8, 10, 40)
            header = ("Sheet", "Stage", "Struct%", "Volume", "Ext Refs", "Fed by")
            lines.append("  ".join(h.ljust(w) for h, w in zip(header, col_widths)))
            lines.append(DASH)
            for name, stage, fed, pct, sc_count, unsc_count, vol, ext in sc:
                fed_text = ", ".join(sorted(fed)) if fed else ""
                row = (name, stage, f"{pct}%", str(vol), str(ext), fed_text)
                lines.append("  ".join(str(v).ljust(w) for v, w in zip(row, col_widths)))
            lines.append("")
        else:
            lines.append(DASH)
            lines.append("SOURCE CLASSIFICATION")
            lines.append(DASH)
            lines.append("(Not run yet - use the Source Classification section above to include it here.)")
            lines.append("")

        lines.append(BAR)
        lines.append("End of Report")
        lines.append(BAR)
        return "\n".join(lines)

    st.download_button(
        "Download Report (.txt)",
        data=build_report_text(),
        file_name="health_check_report.txt",
        mime="text/plain",
    )


if __name__ == "__main__":
    main()
