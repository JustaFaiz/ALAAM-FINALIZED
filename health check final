def write_temp_file(tmp_dir, filename, data_bytes):
    """Writes data_bytes to tmp_dir/filename - but ONLY if that exact
    path doesn't already hold identical content. Streamlit reruns the
    whole script on every widget interaction (including each drag in
    Manual Classification), so without this check the app would try to
    rewrite the same unchanged workbook dozens of times per session.

    If a write IS actually needed and the target path turns out to be
    locked - most commonly because you have the SAME file open in Excel
    to refer to it while working in the dashboard, which is a completely
    reasonable thing to want to do - this falls back to a content-hashed
    filename instead of raising. The fallback name is deterministic
    (same bytes -> same fallback path), so an unchanged file stays on
    the same fallback path across reruns too, and the "skip if already
    identical" check above still applies to it on the next rerun.

    Returns the path actually holding the content, for the caller to
    read from downstream."""
    target = os.path.join(tmp_dir, filename)
    digest = hashlib.md5(data_bytes).hexdigest()[:10]

    def _matches(path):
        try:
            with open(path, "rb") as f:
                return f.read() == data_bytes
        except (PermissionError, OSError):
            return False  # can't even read it back right now - don't trust it

    if os.path.exists(target) and _matches(target):
        return target  # already there, unchanged - nothing to do

    try:
        with open(target, "wb") as f:
            f.write(data_bytes)
        return target
    except (PermissionError, OSError):
        stem, ext = os.path.splitext(filename)
        fallback = os.path.join(tmp_dir, f"{stem}_{digest}{ext}")
        if os.path.exists(fallback) and _matches(fallback):
            return fallback
        with open(fallback, "wb") as f:
            f.write(data_bytes)
        return fallback


def main():
    st.set_page_config(page_title="Workbook Health Check", layout="wide")
    apply_shell_theme()
    st.markdown('<div class="shell-banner">Excel Workbook Health Check</div>', unsafe_allow_html=True)

    # -----------------------------------------------------------
    # Batch Folder Scan - runs independently of the single-file
    # upload flow below. Since this app runs locally on the same
    # machine as the files, a folder PATH works directly - no upload
    # needed. Scans every .xlsx/.xlsm with the same checks as the
    # single-file flow, and every .pdf with a lighter readability check.
    # This is a quick top-level triage pass, separate from the deeper
    # per-workbook analysis (Source Classification, Manual Classification,
    # flow maps) below, which still operates on one uploaded file at a time.
    # -----------------------------------------------------------
    st.subheader("Batch Folder Scan")
    folder_path = st.text_input("Folder path (scans .xlsx, .xlsm, and .pdf files - top-level only, not subfolders)")

    if st.button("Scan Folder"):
        if not folder_path or not os.path.isdir(folder_path):
            shell_box(f"'{folder_path}' isn't a valid folder path.", ok=False)
        else:
            entries = sorted(os.listdir(folder_path))
            excel_files = [e for e in entries if e.lower().endswith((".xlsx", ".xlsm"))]
            pdf_files = [e for e in entries if e.lower().endswith(".pdf")]

            # Scanned in parallel across files - each file is fully
            # independent work (open, parse, check), so this is a good
            # fit for a thread pool even though Python has a GIL: most
            # of the time per file goes into disk I/O and XML parsing
            # (openpyxl/zipfile), both of which release the GIL, so
            # threads give a real speedup here without the process-pool
            # pickling/spawn complications that tend to bite inside
            # Streamlit's script-rerun execution model.
            # Results are also cached per-file (see scan_one_excel_cached/
            # scan_one_pdf_cached above) on (path, mtime, size) - so a
            # repeat scan of a folder where files haven't changed comes
            # back almost instantly, parallel or not.
            excel_paths = [os.path.join(folder_path, f) for f in excel_files]
            pdf_paths = [os.path.join(folder_path, f) for f in pdf_files]
            max_workers = min(8, max(1, len(excel_paths) + len(pdf_paths)))

            excel_rows = []
            pdf_rows = []
            total_files = len(excel_paths) + len(pdf_paths)

            if total_files:
                progress = st.progress(0.0, text=f"Scanning 0/{total_files} file(s)...")
                done = 0
                with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as pool:
                    future_to_kind = {}
                    for p in excel_paths:
                        fut = pool.submit(scan_one_excel_cached, p, _file_fingerprint(p))
                        future_to_kind[fut] = ("excel", p)
                    for p in pdf_paths:
                        fut = pool.submit(scan_one_pdf_cached, p, _file_fingerprint(p))
                        future_to_kind[fut] = ("pdf", p)

                    results_by_path = {}
                    for fut in concurrent.futures.as_completed(future_to_kind):
                        kind, p = future_to_kind[fut]
                        results_by_path[p] = (kind, fut.result())
                        done += 1
                        progress.progress(done / total_files, text=f"Scanning {done}/{total_files} file(s)...")

                progress.empty()
                # Rebuild in original alphabetical order (as_completed finishes
                # out of order) so the tables below display consistently.
                excel_rows = [results_by_path[p][1] for p in excel_paths]
                pdf_rows = [results_by_path[p][1] for p in pdf_paths]

            if not excel_files and not pdf_files:
                shell_box("No .xlsx, .xlsm, or .pdf files found in that folder.", ok=False)

            if excel_rows:
                st.write(f"**Excel files ({len(excel_rows)})**")
                st.dataframe(excel_rows, use_container_width=True)
            if pdf_rows:
                st.write(f"**PDF files ({len(pdf_rows)})**")
                st.dataframe(pdf_rows, use_container_width=True)

    st.divider()

    uploaded = st.file_uploader("Drop your .xlsx or .xlsm workbook here", type=["xlsx", "xlsm"])
    if uploaded is None:
        shell_box("Upload a workbook to run the health check.", ok=True)
        return

    tmp_dir = tempfile.gettempdir()
    file_bytes = uploaded.getbuffer().tobytes()
    tmp_path = write_temp_file(tmp_dir, uploaded.name, file_bytes)

    shell_box(f"Loaded: {uploaded.name}", ok=True)

    @st.cache_data(show_spinner=False)
    def run_analysis(file_bytes, filename, path):
        """Cached on file_bytes+filename - re-uploading or re-clicking
        Run on the SAME unchanged file returns instantly instead of
        re-parsing from scratch."""
        formulas, sheet_names, hidden_sheets, sheet_bounds = load_workbook_data(path)
        precedents, flow = analyze_formulas(formulas, sheet_bounds)
        breaks = check_broken_links(formulas)
        cycles = check_circular_refs(precedents)
        isolated = check_isolated_sheets(sheet_names, flow)
        connections = check_external_connections(path)
        connectivity_stage = derive_connectivity_stage(sheet_names, flow)
        return {
            "formulas": len(formulas), "sheets": len(sheet_names),
            "sheet_names": sheet_names,
            "breaks": breaks, "cycles": cycles, "isolated": isolated,
            "connections": connections, "hidden": hidden_sheets,
            "connectivity_stage": connectivity_stage,
            "flow": flow,
        }

    if st.button("Run Health Check", type="primary"):
        with st.spinner("Analyzing workbook..."):
            st.session_state["results"] = run_analysis(file_bytes, uploaded.name, tmp_path)
            # New workbook analyzed - any previously confirmed classification
            # belonged to the old sheet set, so it must be cleared to avoid
            # showing stale ground truth against a different workbook.
            st.session_state.pop("manual_confirmed", None)
            st.session_state.pop("manual_confirmed_stages", None)
            st.session_state.pop("manual_unclassified_count", None)

    if "results" not in st.session_state:
        return

    r = st.session_state["results"]
    st.caption(f"{r['formulas']} formulas across {r['sheets']} sheets")

    def badge(count, label):
        shell_box(f"{label}: {count} found" if count else f"{label}: none found", ok=(count == 0))

    col1, col2, col3, col4, col5 = st.columns(5)
    with col1:
        badge(len(r["breaks"]), "Broken links")
    with col2:
        badge(len(r["cycles"]), "Circular refs")
    with col3:
        badge(len(r["isolated"]), "Isolated sheets")
    with col4:
        badge(len(r["hidden"]), "Hidden sheets")
    with col5:
        badge(len(r["connections"]), "External connections")

    with st.expander(f"Broken links ({len(r['breaks'])})"):
        if r["breaks"]:
            st.write("Formulas containing Excel's own #REF! error marker (a reference that was deleted/invalidated):")
            st.dataframe(
                [{"Sheet": s, "Cell": c, "Formula": f} for s, c, f in r["breaks"]],
                use_container_width=True,
            )
        else:
            st.write("No #REF! errors found - no genuinely broken references.")

    with st.expander(f"Circular references ({len(r['cycles'])})"):
        if r["cycles"]:
            for cyc in r["cycles"]:
                st.code(" -> ".join(f"{s}!{c}" for s, c in cyc))
        else:
            st.write("No circular references detected.")

    with st.expander(f"Isolated sheets ({len(r['isolated'])})"):
        if r["isolated"]:
            st.write("These sheets have no cross-sheet formula connections at all (nothing feeds them, they feed nothing):")
            st.dataframe([{"Sheet": s} for s in r["isolated"]], use_container_width=True)
        else:
            st.write("Every sheet is connected to the flow.")

    with st.expander(f"Hidden sheets ({len(r['hidden'])})"):
        if r["hidden"]:
            st.dataframe([{"Sheet": s, "State": state} for s, state in r["hidden"]], use_container_width=True)
        else:
            st.write("No hidden sheets.")

    with st.expander(f"External data connections ({len(r['connections'])})"):
        if r["connections"]:
            st.write("These are the workbook's OWN entry points into outside data - the piece formula-tracing can't see past:")
            st.dataframe(
                [{"Name": n, "Type": t, "Connection detail": d} for n, t, d in r["connections"]],
                use_container_width=True,
            )
        else:
            st.write("No Power Query / ODBC / SQL / external connections found in this workbook.")

    st.divider()
    st.subheader("Sheet Flow Visual")
    script_dir = os.path.dirname(os.path.abspath(__file__))
    tree_script_name = st.text_input("Tree visual script filename", value="Sheet_Trace_Visual_6.py")
    tree_script_path = os.path.join(script_dir, tree_script_name)

    if st.button("Open Sheet Flow Visual"):
        if not os.path.exists(tree_script_path):
            shell_box(f"Couldn't find {tree_script_name} in {script_dir}. Make sure it's saved in the same folder as this dashboard.", ok=False)
        else:
            subprocess.Popen([sys.executable, tree_script_path, tmp_path])
            shell_box(f"Launched {tree_script_name} - check your browser for a new tab.", ok=True)

    # -----------------------------------------------------------
    # Source Classification - runs INLINE (imported directly, not
    # launched as a separate process), reusing the SAME uploaded
    # workbook already on this page. Results show right here as a
    # table. Download button lives in its own section below.
    #
    # Stage ordering/labels are read from the loaded classifier
    # module itself (gsc.STAGE_ORDER) rather than duplicated here -
    # that module is the single source of truth for what stages
    # exist, so this dashboard can never drift out of sync with it
    # again the way it did when "External Process"/"External Output"
    # were added to the classifier but not here.
    # -----------------------------------------------------------
    st.divider()
    st.subheader("Source Classification")
    sc_script_name = st.text_input("Source Candidates script filename", value="Source_Candidates_1.py", key="sc_script_name")
    sc_script_path = os.path.join(script_dir, sc_script_name)

    if st.button("Run Source Classification"):
        if not os.path.exists(sc_script_path):
            shell_box(f"Couldn't find {sc_script_name} in {script_dir}. Make sure it's saved in the same folder as this dashboard.", ok=False)
        else:
            with st.spinner("Classifying sheets..."):
                spec = importlib.util.spec_from_file_location("generate_source_candidates", sc_script_path)
                gsc = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(gsc)

                sheets_result = gsc.classify_all_sheets(tmp_path)
                sheets_result.sort(key=lambda s: gsc.STAGE_ORDER[s[1]])

                candidates_path = os.path.join(tmp_dir, "Data_Inventory_Candidates.xlsx")
                gsc.build_output(sheets_result, candidates_path)

            st.session_state["source_candidates"] = sheets_result
            st.session_state["source_candidates_file"] = candidates_path
            # Kept alongside the results so build_report_text() (called
            # on every rerun via the download button below, long after
            # this module object itself is gone) can still tally counts
            # without hardcoding its own copy of the stage list.
            st.session_state["source_stage_order"] = gsc.STAGE_ORDER

    if "source_candidates" in st.session_state:
        sc = st.session_state["source_candidates"]
        st.dataframe(
            [{"Sheet": name, "Stage": stage, "Structured %": f"{pct}%",
              "Structured Cells": sc_count, "Unstructured Cells": unsc_count,
              "Volume": vol, "External Refs": ext, "Fed by": ", ".join(sorted(fed)) if fed else ""}
             for name, stage, fed, pct, sc_count, unsc_count, vol, ext in sc],
            use_container_width=True,
        )

    # -----------------------------------------------------------
    # Download Data Inventory Candidates - its own separate section,
    # only shows once a classification has actually been run above.
    # -----------------------------------------------------------
    st.divider()
    st.subheader("Download Data Inventory Candidates")
    if "source_candidates_file" in st.session_state:
        with open(st.session_state["source_candidates_file"], "rb") as f:
            st.download_button(
                "Download Data_Inventory_Candidates.xlsx",
                data=f.read(),
                file_name="Data_Inventory_Candidates.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            )
    else:
        st.caption("Run Source Classification above first to generate a file to download.")

    # -----------------------------------------------------------
    # Lineage Visualizer - LAUNCHED (same pattern as Sheet Flow
    # Visual), since it's a custom interactive graph, not something
    # that fits Streamlit's own widgets. Needs its OWN upload since
    # it reads a filled-in lineage template, not the raw workpaper.
    # -----------------------------------------------------------
    st.divider()
    st.subheader("Lineage Visualizer")
    st.caption("Uses a separate, manually-filled Data Inventory / Lineage Hops file - not the workbook uploaded above.")
    lineage_upload = st.file_uploader("Drop your Data Lineage Template (.xlsx)", type=["xlsx"], key="lineage_upload")
    lv_script_name = st.text_input("Lineage visual script filename", value="Lineage_Visual.py", key="lv_script_name")

    if lineage_upload is not None:
        lineage_bytes = lineage_upload.getbuffer().tobytes()
        lineage_tmp_path = write_temp_file(tmp_dir, lineage_upload.name, lineage_bytes)
        lv_script_path = os.path.join(script_dir, lv_script_name)

        if st.button("Open Lineage Visual"):
            if not os.path.exists(lv_script_path):
                shell_box(f"Couldn't find {lv_script_name} in {script_dir}. Make sure it's saved in the same folder as this dashboard.", ok=False)
            else:
                subprocess.Popen([sys.executable, lv_script_path, lineage_tmp_path])
                shell_box(f"Launched {lv_script_name} - check your browser for a new tab.", ok=True)

    # -----------------------------------------------------------
    # Manual Classification & Comparison - drag sheets into Input/
    # Process/Output by hand (ground truth from actual domain
    # knowledge), then CONFIRM it to lock it in as the solid,
    # displayed source of truth. Everything downstream - the
    # comparison against automated methods AND the flow-mapping
    # visual - only becomes available once confirmed. This enforces
    # the order: establish the real I/P/O first, THEN map flow on
    # top of it, instead of the two happening interchangeably.
    # -----------------------------------------------------------
    st.divider()
    st.subheader("Manual Classification & Comparison")
    st.caption("Drag each sheet into Input, Process, or Output based on what you actually know about it, then confirm to lock it in. Flow mapping only unlocks after confirmation.")

    sheet_names = r.get("sheet_names", [])
    if sheet_names:
        initial_containers = [
            {"header": "Unclassified", "items": list(sheet_names)},
            {"header": "Input", "items": []},
            {"header": "Process", "items": []},
            {"header": "Output", "items": []},
        ]
        sorted_result = sort_items(
            initial_containers,
            multi_containers=True,
            direction="vertical",
            key="manual_classification_sortable",
        )

        if st.button("Confirm Classification", type="primary"):
            manual_map = {}
            unclassified_count = 0
            for container in sorted_result:
                bucket = container["header"]
                items = container["items"]
                if bucket == "Unclassified":
                    unclassified_count = len(items)
                    continue
                for sheet in items:
                    manual_map[sheet] = bucket

            if not manual_map:
                shell_box("No sheets classified yet - drag at least one sheet into Input, Process, or Output before confirming.", ok=False)
            else:
                st.session_state["manual_confirmed_stages"] = manual_map
                st.session_state["manual_confirmed"] = True
                st.session_state["manual_unclassified_count"] = unclassified_count

        if st.session_state.get("manual_confirmed"):
            confirmed = st.session_state["manual_confirmed_stages"]
            shell_box(f"Classification confirmed - {len(confirmed)} sheet(s) locked in as ground truth.", ok=True)

            # Solid display of the confirmed I/P/O - this is the actual
            # answer, shown plainly before anything else happens with it.
            stage_groups = {"Input": [], "Process": [], "Output": []}
            for sheet, stage in confirmed.items():
                stage_groups.setdefault(stage, []).append(sheet)

            conf_col1, conf_col2, conf_col3 = st.columns(3)
            for col, stage in zip((conf_col1, conf_col2, conf_col3), ("Input", "Process", "Output")):
                with col:
                    st.markdown(f"**{stage} ({len(stage_groups.get(stage, []))})**")
                    if stage_groups.get(stage):
                        for s in sorted(stage_groups[stage]):
                            st.write(f"- {s}")
                    else:
                        st.caption("None")

            unclassified_ct = st.session_state.get("manual_unclassified_count", 0)
            if unclassified_ct:
                st.caption(f"({unclassified_ct} sheet(s) still Unclassified - not included in the confirmed set above. Drag them into a bucket and re-confirm if they should be included.)")

            st.divider()

            if st.button("Compare Classifications"):
                connectivity_stage = r.get("connectivity_stage", {})
                source_stage = {}
                if "source_candidates" in st.session_state:
                    for name, stage, fed, pct, sc_count, unsc_count, vol, ext in st.session_state["source_candidates"]:
                        source_stage[name] = stage

                comparison_rows = []
                conn_matches = 0
                src_matches = 0
                compared_count = 0
                for sheet, manual_stage in confirmed.items():
                    conn = connectivity_stage.get(sheet, "?")
                    src = source_stage.get(sheet, "(not run)")
                    conn_match = (conn == manual_stage)
                    src_match = (src == manual_stage) if src != "(not run)" else None
                    if conn_match:
                        conn_matches += 1
                    if src_match:
                        src_matches += 1
                    if src != "(not run)":
                        compared_count += 1
                    comparison_rows.append({
                        "Sheet": sheet,
                        "Manual": manual_stage,
                        "Connectivity-Based": conn,
                        "Connectivity Match": "Yes" if conn_match else "No",
                        "Source Classification": src,
                        "Source Match": ("Yes" if src_match else "No") if src_match is not None else "-",
                    })

                if comparison_rows:
                    st.dataframe(comparison_rows, use_container_width=True)
                    total = len(comparison_rows)
                    conn_pct = round(conn_matches / total * 100, 1) if total else 0
                    shell_box(f"Connectivity-based classification matched manual for {conn_matches}/{total} sheets ({conn_pct}%)", ok=(conn_pct >= 70))
                    if compared_count:
                        src_pct = round(src_matches / compared_count * 100, 1)
                        shell_box(f"Source Classification matched manual for {src_matches}/{compared_count} sheets ({src_pct}%)", ok=(src_pct >= 70))
                    else:
                        shell_box("Source Classification hasn't been run yet - run it above to include it in this comparison.", ok=True)

            # Flow mapping - only reachable after Confirm Classification
            # has been clicked above. Uses the CONFIRMED map, not
            # whatever is currently sitting in the drag-and-drop boxes,
            # so the visual always reflects the locked-in ground truth.
            if "flow" in r:
                if st.button("Build Sheet Flow Visual (Manual Stages)"):
                    html = build_manual_stage_tree_html(r["flow"], confirmed, sheet_names)
                    out_path = os.path.join(tmp_dir, "manual_stage_tree.html")
                    with open(out_path, "w", encoding="utf-8") as f:
                        f.write(html)
                    webbrowser.open(f"file:///{out_path}")
                    shell_box("Opened the visual in a new browser tab.", ok=True)

                st.caption("Locked Input -> Process -> Output columns, showing only the real formula-flow path(s) from a confirmed Input to a confirmed Output.")
                if st.button("Open Input \u2192 Output Flow Map"):
                    html, error = build_staged_flow_html(r["flow"], confirmed, sheet_names)
                    io_out_path = os.path.join(tmp_dir, "input_output_flow_map.html")
                    if html is None:
                        html = NO_PATH_HTML_TEMPLATE.replace("__MESSAGE__", error)
                        with open(io_out_path, "w", encoding="utf-8") as f:
                            f.write(html)
                        webbrowser.open(f"file:///{io_out_path}")
                        shell_box(error, ok=False)
                    else:
                        with open(io_out_path, "w", encoding="utf-8") as f:
                            f.write(html)
                        webbrowser.open(f"file:///{io_out_path}")
                        shell_box("Opened the Input \u2192 Output flow map in a new browser tab.", ok=True)
        else:
            st.info("Drag sheets into Input, Process, or Output above, then click **Confirm Classification** to lock it in. Flow mapping unlocks after that.")
    else:
        st.caption("Run Health Check above first so sheet names are available to classify.")

    def build_report_text():
        BAR = "=" * 78
        DASH = "-" * 78
        lines = []

        lines.append(BAR)
        lines.append("EXCEL WORKBOOK HEALTH CHECK REPORT")
        lines.append(BAR)
        lines.append(f"Workbook:  {uploaded.name}")
        lines.append(f"Generated: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        lines.append(f"{r['formulas']} formulas across {r['sheets']} sheets")
        lines.append("")

        # --- Health Check section ---
        lines.append(DASH)
        lines.append("HEALTH CHECK")
        lines.append(DASH)
        lines.append("")

        lines.append(f"Broken Links ({len(r['breaks'])})")
        if r["breaks"]:
            for s, c, f in r["breaks"]:
                lines.append(f"  - {s}!{c} : {f}")
        else:
            lines.append("  None found.")
        lines.append("")

        lines.append(f"Circular References ({len(r['cycles'])})")
        if r["cycles"]:
            for cyc in r["cycles"]:
                lines.append("  - " + " -> ".join(f"{s}!{c}" for s, c in cyc))
        else:
            lines.append("  None found.")
        lines.append("")

        lines.append(f"Isolated Sheets ({len(r['isolated'])})")
        if r["isolated"]:
            for s in r["isolated"]:
                lines.append(f"  - {s}")
        else:
            lines.append("  None - every sheet is connected to the flow.")
        lines.append("")

        lines.append(f"Hidden Sheets ({len(r['hidden'])})")
        if r["hidden"]:
            for s, state in r["hidden"]:
                lines.append(f"  - {s} ({state})")
        else:
            lines.append("  None found.")
        lines.append("")

        lines.append(f"External Data Connections ({len(r['connections'])})")
        if r["connections"]:
            for name, ctype, detail in r["connections"]:
                lines.append(f"  - {name} ({ctype}): {detail}")
        else:
            lines.append("  None found.")
        lines.append("")

        # --- Confirmed Manual Classification section (only if confirmed) ---
        if st.session_state.get("manual_confirmed"):
            confirmed = st.session_state["manual_confirmed_stages"]
            stage_groups = {"Input": [], "Process": [], "Output": []}
            for sheet, stage in confirmed.items():
                stage_groups.setdefault(stage, []).append(sheet)

            lines.append(DASH)
            lines.append("CONFIRMED CLASSIFICATION (MANUAL, GROUND TRUTH)")
            lines.append(DASH)
            lines.append("")
            for stage in ("Input", "Process", "Output"):
                sheets_in_stage = sorted(stage_groups.get(stage, []))
                lines.append(f"{stage} ({len(sheets_in_stage)})")
                if sheets_in_stage:
                    for s in sheets_in_stage:
                        lines.append(f"  - {s}")
                else:
                    lines.append("  None.")
                lines.append("")
        else:
            lines.append(DASH)
            lines.append("CONFIRMED CLASSIFICATION (MANUAL, GROUND TRUTH)")
            lines.append(DASH)
            lines.append("(Not confirmed yet - use the Manual Classification section above to lock it in.)")
            lines.append("")

        # --- Source Classification section (only if it's been run) ---
        if "source_candidates" in st.session_state:
            sc = st.session_state["source_candidates"]
            # Stage list comes from the classifier module itself (saved
            # when Source Classification was run), not a second hardcoded
            # copy here - see comment above the "Run Source Classification"
            # button for why. Falls back to whatever stages actually show
            # up in the results if that wasn't saved for some reason, so
            # this section can't itself throw a KeyError on an unknown stage.
            stage_order = st.session_state.get("source_stage_order")
            if stage_order:
                stage_counts = {stage: 0 for stage in stage_order}
            else:
                stage_counts = {}
            for _, stage, _, _, _, _, _, _ in sc:
                stage_counts[stage] = stage_counts.get(stage, 0) + 1

            lines.append(DASH)
            lines.append("SOURCE CLASSIFICATION")
            lines.append(DASH)
            lines.append("")
            summary_parts = [f"{count} {stage}" for stage, count in stage_counts.items() if count > 0]
            lines.append(f"{len(sc)} sheet(s) total: " + ", ".join(summary_parts))
            lines.append("")

            col_widths = (22, 15, 9, 8, 10, 40)
            header = ("Sheet", "Stage", "Struct%", "Volume", "Ext Refs", "Fed by")
            lines.append("  ".join(h.ljust(w) for h, w in zip(header, col_widths)))
            lines.append(DASH)
            for name, stage, fed, pct, sc_count, unsc_count, vol, ext in sc:
                fed_text = ", ".join(sorted(fed)) if fed else ""
                row = (name, stage, f"{pct}%", str(vol), str(ext), fed_text)
                lines.append("  ".join(str(v).ljust(w) for v, w in zip(row, col_widths)))
            lines.append("")
        else:
            lines.append(DASH)
            lines.append("SOURCE CLASSIFICATION")
            lines.append(DASH)
            lines.append("(Not run yet - use the Source Classification section above to include it here.)")
            lines.append("")

        lines.append(BAR)
        lines.append("End of Report")
        lines.append(BAR)
        return "\n".join(lines)

    st.download_button(
        "Download Report (.txt)",
        data=build_report_text(),
        file_name="health_check_report.txt",
        mime="text/plain",
    )


if __name__ == "__main__":
    main()
