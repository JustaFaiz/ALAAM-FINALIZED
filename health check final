def build_staged_flow_html(flow, manual_stages, sheet_names):
    """Builds the LOCKED Input -> Process -> Output flow map: columns are
    fixed by your CONFIRMED classification (not re-derived from the graph),
    and the only edges drawn are ones that lie on an actual formula-flow
    path from a confirmed Input sheet to a confirmed Output sheet - traced
    hop by hop through real sheet-to-sheet formula references, same data
    as the rest of the dashboard (r['flow']), not a fresh guess.

    Sheets in between that were never manually classified can still appear
    if a real formula path runs through them on its way to an Output - they
    show up as muted "pass-through" nodes so the path stays intact and
    honest, without pretending they were classified.

    Any Input or Process or Output sheet that doesn't actually connect to
    an Output (or wasn't reached by any Input) is deliberately left out of
    this diagram - it isn't part of the input-to-output story, even though
    it's part of the confirmed classification. That's a genuinely different
    question than "how does data flow start to finish."
    """
    input_sheets = {s for s, stage in manual_stages.items() if stage == "Input"}
    output_sheets = {s for s, stage in manual_stages.items() if stage == "Output"}

    if not input_sheets or not output_sheets:
        return None, "The confirmed classification doesn't include at least one Input sheet and one Output sheet, so there's nothing to trace a path between."

    # Forward adjacency (src -> [dst, ...]) built once from the real flow data.
    forward = {}
    for (src, dst), count in flow.items():
        forward.setdefault(src, []).append((dst, count))

    # Reverse adjacency (dst -> [src, ...]) for the backward reachability pass.
    reverse = {}
    for (src, dst), count in flow.items():
        reverse.setdefault(dst, []).append((src, count))

    # Every sheet reachable FORWARD from any confirmed Input sheet.
    forward_reachable = set()
    queue = list(input_sheets)
    forward_reachable.update(input_sheets)
    while queue:
        node = queue.pop()
        for dst, _ in forward.get(node, []):
            if dst not in forward_reachable:
                forward_reachable.add(dst)
                queue.append(dst)

    # Every sheet that can reach BACKWARD to any confirmed Output sheet.
    backward_reachable = set()
    queue = list(output_sheets)
    backward_reachable.update(output_sheets)
    while queue:
        node = queue.pop()
        for src, _ in reverse.get(node, []):
            if src not in backward_reachable:
                backward_reachable.add(src)
                queue.append(src)

    # The corridor: sheets that are BOTH downstream of an Input AND
    # upstream of an Output - i.e. genuinely on some Input -> Output path.
    corridor = forward_reachable & backward_reachable

    if not corridor or not (corridor & input_sheets) or not (corridor & output_sheets):
        return None, "None of the confirmed Input sheets have a formula path that actually reaches a confirmed Output sheet yet, based on the current formulas."

    # BFS distance from the nearest Input sheet, restricted to the corridor,
    # used purely to position columns left-to-right in the visual.
    level = {s: 0 for s in corridor & input_sheets}
    queue = list(level.keys())
    while queue:
        node = queue.pop(0)
        for dst, _ in forward.get(node, []):
            if dst in corridor and dst not in level:
                level[dst] = level[node] + 1
                queue.append(dst)
    # Safety net: any corridor node BFS didn't reach directly from an Input
    # (shouldn't normally happen given forward_reachable) gets pushed to the end.
    max_level = max(level.values(), default=0)
    for s in corridor:
        if s not in level:
            max_level += 1
            level[s] = max_level

    nodes = []
    for sheet in corridor:
        stage = manual_stages.get(sheet)
        if stage == "Input":
            color, border, width, bold = "#2ecc71", "#ffffff", 3, True
            title = f"{sheet}\\nInput (confirmed)"
        elif stage == "Process":
            color, border, width, bold = "#2a9d8f", "#ffffff", 3, True
            title = f"{sheet}\\nProcess (confirmed)"
        elif stage == "Output":
            color, border, width, bold = "#f39c12", "#ffffff", 3, True
            title = f"{sheet}\\nOutput (confirmed)"
        else:
            color, border, width, bold = "#8e6bbf", "#555555", 1, False
            title = f"{sheet}\\nPass-through (not classified)"
        nodes.append({
            "id": sheet,
            "label": sheet,
            "shape": "box",
            "level": level[sheet],
            "title": title,
            "color": {"background": color, "border": border},
            "borderWidth": width,
            "font": {"color": "#ffffff", "bold": bold},
        })

    edges = []
    for (src, dst), count in flow.items():
        if src in corridor and dst in corridor:
            edges.append({"from": src, "to": dst, "label": str(count), "title": f"{count} formula cells"})

    html = STAGED_FLOW_HTML_TEMPLATE.replace("__NODES__", json.dumps(nodes)).replace("__EDGES__", json.dumps(edges))
    return html, None


def derive_connectivity_stage(sheet_names, flow):
    """Classifies each sheet by CONNECTIVITY ALONE (same signal the tree
    visual uses for root/leaf/middle coloring) - completely independent
    of the structured-%-based Source Classification:
    - Input:    feeds other sheets, nothing feeds it
    - Process:  both receives from and feeds into other sheets
    - Output:   receives from other sheets, feeds nothing further
    - Isolated: no cross-sheet connections at all
    Returns a dict: sheet_name -> stage."""
    has_incoming = set()
    has_outgoing = set()
    for src, dst in flow:
        has_outgoing.add(src)
        has_incoming.add(dst)

    stages = {}
    for sheet in sheet_names:
        incoming = sheet in has_incoming
        outgoing = sheet in has_outgoing
        if incoming and outgoing:
            stages[sheet] = "Process"
        elif outgoing and not incoming:
            stages[sheet] = "Input"
        elif incoming and not outgoing:
            stages[sheet] = "Output"
        else:
            stages[sheet] = "Isolated"
    return stages


def check_isolated_sheets(sheet_names, flow):
    connected = set()
    for src, dst in flow:
        connected.add(src)
        connected.add(dst)
    return [s for s in sheet_names if s not in connected]


def check_pdf(path):
    """Lightweight PDF health check - not trying to apply Excel-style
    concepts (broken formulas etc don't exist for PDFs). Just: is it
    actually readable, how many pages, and does it have a real text
    layer at all - a scanned image with no extractable text matters a
    lot for anything downstream trying to process it automatically."""
    try:
        from pypdf import PdfReader
        reader = PdfReader(path)
        num_pages = len(reader.pages)
        has_text = False
        for page in reader.pages[:5]:  # sample first 5 pages, not every page - just need a signal
            if (page.extract_text() or "").strip():
                has_text = True
                break
        encrypted = reader.is_encrypted
        return {"readable": True, "pages": num_pages, "has_text": has_text,
                "encrypted": encrypted, "error": ""}
    except Exception as e:
        return {"readable": False, "pages": 0, "has_text": False,
                "encrypted": False, "error": str(e)}


def _file_fingerprint(path):
    """(mtime, size) for a file - passed into the cached scan functions
    below as part of the cache key, so a file that hasn't changed since
    the last scan returns instantly from cache, and a file that HAS
    changed (different mtime/size) is correctly treated as a cache miss
    and re-scanned. Purely a cache-invalidation signal, not used for
    anything else."""
    stat = os.stat(path)
    return (stat.st_mtime, stat.st_size)


@st.cache_data(show_spinner=False)
def scan_one_excel_cached(path, fingerprint):
    """Runs the same checks as the single-file flow for one workbook and
    returns a single summary row. Cached on (path, fingerprint) - a
    repeat Scan Folder on an unchanged file returns instantly instead of
    re-parsing. Wrapped in try/except since a batch scan shouldn't abort
    on one bad file; failures show up as an ERROR row instead."""
    fname = os.path.basename(path)
    try:
        formulas, sheet_names, hidden_sheets, sheet_bounds = load_workbook_data(path)
        precedents, flow = analyze_formulas(formulas, sheet_bounds)
        breaks = check_broken_links(formulas)
        cycles = check_circular_refs(precedents)
        isolated = check_isolated_sheets(sheet_names, flow)
        connections = check_external_connections(path)
        return {
            "File": fname, "Sheets": len(sheet_names), "Formulas": len(formulas),
            "Broken Links": len(breaks), "Circular Refs": len(cycles),
            "Isolated Sheets": len(isolated), "Hidden Sheets": len(hidden_sheets),
            "External Connections": len(connections),
        }
    except Exception as e:
        return {"File": fname, "Sheets": "ERROR", "Formulas": str(e)[:60],
                "Broken Links": "-", "Circular Refs": "-",
                "Isolated Sheets": "-", "Hidden Sheets": "-",
                "External Connections": "-"}


@st.cache_data(show_spinner=False)
def scan_one_pdf_cached(path, fingerprint):
    """Same caching approach as scan_one_excel_cached, for the lighter
    PDF readability check."""
    fname = os.path.basename(path)
    result = check_pdf(path)
    return {
        "File": fname, "Readable": "Yes" if result["readable"] else "No",
        "Pages": result["pages"], "Has Text Layer": "Yes" if result["has_text"] else "No",
        "Encrypted": "Yes" if result["encrypted"] else "No",
        "Error": result["error"][:60],
    }


def check_external_connections(path):
    """Reads xl/connections.xml directly from the xlsx zip - this is
    where Excel stores Power Query / ODBC / SQL / web data connections.
    Not visible to formula parsing since it's workbook metadata, not a
    cell formula."""
    connections = []
    try:
        with zipfile.ZipFile(path) as z:
            if "xl/connections.xml" not in z.namelist():
                return connections
            with z.open("xl/connections.xml") as f:
                tree = ET.parse(f)
                root = tree.getroot()
                ns = {"m": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
                for conn in root.findall(".//m:connection", ns):
                    name = conn.get("name", "(unnamed)")
                    conn_type = conn.get("type", "")
                    db_pr = conn.find("m:dbPr", ns)
                    detail = db_pr.get("connection") if db_pr is not None else ""
                    connections.append((name, conn_type, detail or ""))
    except Exception:
        pass
    return connections


