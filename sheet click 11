def build_html(flow, min_cells):
    strong = {k: v for k, v in flow.items() if v >= min_cells}
    if not strong:
        return None

    all_sheets = set()
    has_incoming = set()
    has_outgoing = set()
    for src, dst in strong:
        all_sheets.add(src)
        all_sheets.add(dst)
        has_outgoing.add(src)
        has_incoming.add(dst)

    roots = all_sheets - has_incoming
    leaves = all_sheets - has_outgoing

    nodes = []
    for sheet in all_sheets:
        if sheet in roots:
            color = "#2ecc71"
        elif sheet in leaves:
            color = "#f39c12"
        else:
            color = "#2a9d8f"
        nodes.append({
            "id": sheet, "label": sheet, "color": color,
            "shape": "box", "size": 25,
            "title": f"{sheet}\\nClick to switch to this sheet in Excel"
        })

    max_count = max(strong.values())
    edges = []
    for (src, dst), count in strong.items():
        width = 1 + (count / max_count) * 8
        edges.append({
            "from": src, "to": dst, "value": width,
            "label": str(count), "title": f"{count} formula cells"
        })

    return HTML_TEMPLATE.replace("__NODES__", json.dumps(nodes)).replace("__EDGES__", json.dumps(edges))


class Handler(BaseHTTPRequestHandler):
    html_content = ""
    workbook_path = ""
    precedent_cells = {}
    dependent_cells = {}

    def log_message(self, format, *args):
        pass  # keep the terminal quiet

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path in ("/", "/sheet_tree.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(Handler.html_content.encode("utf-8"))
        elif parsed.path == "/open":
            qs = parse_qs(parsed.query)
            sheet = qs.get("sheet", [None])[0]
            want_precedents = qs.get("precedents", ["true"])[0].lower() == "true"
            want_dependents = qs.get("dependents", ["true"])[0].lower() == "true"
            status = "ok"
            try:
                pre = sorted(Handler.precedent_cells.get(sheet, [])) if want_precedents else []
                dep = sorted(Handler.dependent_cells.get(sheet, [])) if want_dependents else []
                open_sheet_in_excel(Handler.workbook_path, sheet, precedent_cells=pre, dependent_cells=dep)
            except Exception as e:
                status = str(e)
                print(f"[!] Could not open sheet '{sheet}' in Excel: {e}")
                import traceback
                traceback.print_exc()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(status.encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()


def main():
    path = sys.argv[1] if len(sys.argv) >= 2 else DEFAULT_FILE
    if len(sys.argv) < 2:
        print(f"(No file given - using default: {path})")

    min_cells = DEFAULT_MIN_CELLS
    if len(sys.argv) >= 3:
        try:
            min_cells = int(sys.argv[2])
        except ValueError:
            pass

    formulas, wb, sheet_bounds = load_formulas(path)
    print(f"Loaded {len(formulas)} formulas across {len(wb.sheetnames)} sheet(s).")

    flow, precedent_cells, dependent_cells = build_sheet_flow(formulas, sheet_bounds, min_cells=min_cells)
    print(f"Found {len(flow)} distinct sheet-to-sheet links. Showing links with {min_cells}+ cells.")

    html = build_html(flow, min_cells)
    if html is None:
        print(f"No links with {min_cells}+ cells found - nothing to draw. Try a lower threshold.")
        return

    Handler.html_content = html
    Handler.workbook_path = path
    Handler.precedent_cells = precedent_cells
    Handler.dependent_cells = dependent_cells

    server = HTTPServer(("127.0.0.1", PORT), Handler)
    url = f"http://127.0.0.1:{PORT}/"
    print(f"\nServing tree at {url}")
    print("Opening it in your browser now. Leave this window open while you use it - press Ctrl+C here to stop.")
    print("Clicking a sheet draws Trace Precedents arrows (what feeds it) AND Trace Dependents arrows")
    print("(what it feeds) - so input/source sheets show something too, not just middle/output sheets.")
    threading.Timer(0.5, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
