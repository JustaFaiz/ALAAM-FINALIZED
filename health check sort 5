def build_manual_stage_tree_html(flow, manual_stages, sheet_names, min_cells=1):
    """Builds the sheet-flow tree colored by your MANUAL classification
    directly - your own domain judgment on Input/Process/Output for
    each sheet, treated as correct. Flow EDGES are still the real,
    actual formula references between sheets, same as the regular tree
    visual. Sheets you never dragged into a bucket (still Unclassified)
    show muted gray, since there's genuinely no classification for them."""
    strong_flow = {k: v for k, v in flow.items() if v >= min_cells}

    all_sheets = set(sheet_names)
    for src, dst in strong_flow:
        all_sheets.add(src)
        all_sheets.add(dst)

    nodes = []
    for sheet in all_sheets:
        if sheet in manual_stages:
            stage = manual_stages[sheet]
            color = VALIDATED_STAGE_COLORS.get(stage, UNVALIDATED_COLOR)
            title = f"{sheet}\\nStage: {stage}"
        else:
            color = UNVALIDATED_COLOR
            title = f"{sheet}\\nNot classified"
        nodes.append({"id": sheet, "label": sheet, "color": color, "shape": "box", "title": title})

    edges = []
    for (src, dst), count in strong_flow.items():
        edges.append({"from": src, "to": dst, "label": str(count), "title": f"{count} formula cells"})

    return VALIDATED_TREE_HTML_TEMPLATE.replace("__NODES__", json.dumps(nodes)).replace("__EDGES__", json.dumps(edges))


def derive_connectivity_stage(sheet_names, flow):
    """Classifies each sheet by CONNECTIVITY ALONE (same signal the tree
    visual uses for root/leaf/middle coloring) - completely independent
    of the structured-%-based Source Classification:
    - Input:    feeds other sheets, nothing feeds it
    - Process:  both receives from and feeds into other sheets
    - Output:   receives from other sheets, feeds nothing further
    - Isolated: no cross-sheet connections at all
    Returns a dict: sheet_name -> stage."""
    has_incoming = set()
    has_outgoing = set()
    for src, dst in flow:
        has_outgoing.add(src)
        has_incoming.add(dst)

    stages = {}
    for sheet in sheet_names:
        incoming = sheet in has_incoming
        outgoing = sheet in has_outgoing
        if incoming and outgoing:
            stages[sheet] = "Process"
        elif outgoing and not incoming:
            stages[sheet] = "Input"
        elif incoming and not outgoing:
            stages[sheet] = "Output"
        else:
            stages[sheet] = "Isolated"
    return stages


def check_isolated_sheets(sheet_names, flow):
    connected = set()
    for src, dst in flow:
        connected.add(src)
        connected.add(dst)
    return [s for s in sheet_names if s not in connected]


def check_external_connections(path):
    """Reads xl/connections.xml directly from the xlsx zip - this is
    where Excel stores Power Query / ODBC / SQL / web data connections.
    Not visible to formula parsing since it's workbook metadata, not a
    cell formula."""
    connections = []
    try:
        with zipfile.ZipFile(path) as z:
            if "xl/connections.xml" not in z.namelist():
                return connections
            with z.open("xl/connections.xml") as f:
                tree = ET.parse(f)
                root = tree.getroot()
                ns = {"m": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
                for conn in root.findall(".//m:connection", ns):
                    name = conn.get("name", "(unnamed)")
                    conn_type = conn.get("type", "")
                    db_pr = conn.find("m:dbPr", ns)
                    detail = db_pr.get("connection") if db_pr is not None else ""
                    connections.append((name, conn_type, detail or ""))
    except Exception:
        pass
    return connections


