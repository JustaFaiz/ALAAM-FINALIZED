CELL_REF_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])(\$?[A-Z]{1,3}\$?\d{1,7})(?::(\$?[A-Z]{1,3}\$?\d{1,7}))?(?!\()"
)
COLUMN_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?([A-Z]{1,3})\$?:\$?([A-Z]{1,3})\$?(?![A-Za-z0-9_])"
)
ROW_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?(\d{1,7})\$?:\$?(\d{1,7})\$?(?![A-Za-z0-9_])"
)

FULL_RANGE_ROW_CAP = 5000
FULL_RANGE_COL_CAP = 200


def _spans_overlap(span, other_spans):
    s0, s1 = span
    for a0, a1 in other_spans:
        if s0 < a1 and a0 < s1:
            return True
    return False


def extract_refs(formula, current_sheet, sheet_bounds):
    """Returns list of (sheet, cell, is_range). is_range=True means this
    cell came from expanding a multi-cell range or full-column/row ref -
    used to keep the dependents-arrow feature from trying to draw
    thousands of individual arrows for something like a full column."""
    refs = []
    matched_spans = []

    for m in CELL_REF_RE.finditer(formula):
        matched_spans.append(m.span())
        sheet = m.group(1) or m.group(2) or current_sheet
        cell1 = m.group(3).replace('$', '')
        cell2 = m.group(4)
        if cell2:
            cell2 = cell2.replace('$', '')
            try:
                min_col, min_row, max_col, max_row = range_boundaries(f"{cell1}:{cell2}")
                for r in range(min_row, max_row + 1):
                    for c in range(min_col, max_col + 1):
                        refs.append((sheet, f"{get_column_letter(c)}{r}", True))
            except Exception:
                continue
        else:
            refs.append((sheet, cell1, False))

    for m in COLUMN_ONLY_RE.finditer(formula):
        if _spans_overlap(m.span(), matched_spans):
            continue
        sheet = m.group(1) or m.group(2) or current_sheet
        col1, col2 = m.group(3), m.group(4)
        c1, c2 = column_index_from_string(col1), column_index_from_string(col2)
        if c1 > c2:
            c1, c2 = c2, c1
        max_row = min(sheet_bounds.get(sheet, (FULL_RANGE_ROW_CAP, 1))[0], FULL_RANGE_ROW_CAP) or 1
        for c in range(c1, c2 + 1):
            col_letter = get_column_letter(c)
            for r in range(1, max_row + 1):
                refs.append((sheet, f"{col_letter}{r}", True))

    for m in ROW_ONLY_RE.finditer(formula):
        if _spans_overlap(m.span(), matched_spans):
            continue
        sheet = m.group(1) or m.group(2) or current_sheet
        row1, row2 = int(m.group(3)), int(m.group(4))
        if row1 > row2:
            row1, row2 = row2, row1
        max_col = min(sheet_bounds.get(sheet, (1, FULL_RANGE_COL_CAP))[1], FULL_RANGE_COL_CAP) or 1
        for r in range(row1, row2 + 1):
            for c in range(1, max_col + 1):
                refs.append((sheet, f"{get_column_letter(c)}{r}", True))

    return refs


def load_formulas(path):
    wb = load_workbook(path, data_only=False)
    formulas = {}
    sheet_bounds = {}
    for ws in wb.worksheets:
        sheet_bounds[ws.title] = (ws.max_row or 1, ws.max_column or 1)
        for row in ws.iter_rows():
            for cell in row:
                if isinstance(cell.value, str) and cell.value.startswith('='):
                    formulas[(ws.title, cell.coordinate)] = cell.value
    return formulas, wb, sheet_bounds


def build_sheet_flow(formulas, sheet_bounds):
    """Returns (flow, precedent_cells, dependent_cells):
    - flow: (src_sheet, dst_sheet) -> cell count, for the tree/edges
    - precedent_cells: sheet -> cells on that sheet whose formulas pull
      from another sheet (used to draw Trace Precedents arrows)
    - dependent_cells: sheet -> cells on that sheet that get pulled INTO
      formulas on other sheets (used to draw Trace Dependents arrows -
      this is what makes input/source sheets show arrows too, since they
      have no precedents of their own by definition)."""
    flow = {}
    precedent_cells = {}
    dependent_cells = {}
    for (sheet, cell), f in formulas.items():
        refs = extract_refs(f, sheet, sheet_bounds)
        cross_sheet_refs = [(s, c, is_range) for s, c, is_range in refs if s != sheet]
        source_sheets = set(s for s, c, is_range in cross_sheet_refs)
        for src in source_sheets:
            key = (src, sheet)
            flow[key] = flow.get(key, 0) + 1
        if cross_sheet_refs:
            precedent_cells.setdefault(sheet, set()).add(cell)
        for src_sheet, src_cell, is_range in cross_sheet_refs:
            if not is_range:
                dependent_cells.setdefault(src_sheet, set()).add(src_cell)
    return flow, precedent_cells, dependent_cells


_last_auto_unhidden = {"path": None, "sheet": None}


def open_sheet_in_excel(workbook_path, sheet_name, precedent_cells=None, dependent_cells=None):
    """Uses pywin32 COM automation to actually drive Excel - no add-in
    required, this is the same mechanism VBA macros use. Grabs an
    already-running Excel instance if one has this workbook open;
    otherwise starts Excel and opens it fresh. Draws Trace Precedents
    arrows on precedent_cells (this sheet's formulas pulling from
    elsewhere) and Trace Dependents arrows on dependent_cells (this
    sheet's cells being pulled into formulas elsewhere) - covers both
    directions so source/input sheets, which have no precedents of
    their own, still show something meaningful."""
    import win32com.client as win32
    import pywintypes
    import win32gui
    import win32process
    import win32api
    import win32con

    def norm(p):
        return os.path.normcase(os.path.normpath(p))

    abs_path = os.path.abspath(workbook_path)
    target_norm = norm(abs_path)
    target_base = os.path.basename(abs_path).lower()

    excel = None
    wb = None

    try:
        excel = win32.GetActiveObject("Excel.Application")
    except pywintypes.com_error:
        excel = None

    if excel is not None:
        for book in excel.Workbooks:
            try:
                if norm(book.FullName) == target_norm:
                    wb = book
                    break
            except Exception:
                continue
        if wb is None:
            for book in excel.Workbooks:
                try:
                    if book.Name.lower() == target_base:
                        wb = book
                        break
                except Exception:
                    continue

    if excel is None:
        excel = win32.Dispatch("Excel.Application")

    excel.Visible = True
    excel.DisplayAlerts = False
    try:
        excel.AskToUpdateLinks = False
    except Exception:
        pass

    if wb is None:
        wb = excel.Workbooks.Open(abs_path, 0)

    wb.Activate()

    global _last_auto_unhidden
    if (_last_auto_unhidden["path"] == target_norm
            and _last_auto_unhidden["sheet"] is not None
            and _last_auto_unhidden["sheet"] != sheet_name):
        try:
            wb.Sheets(_last_auto_unhidden["sheet"]).Visible = 0
        except Exception:
            pass
        _last_auto_unhidden["sheet"] = None

    sht = wb.Sheets(sheet_name)
    was_hidden = sht.Visible != -1
    if was_hidden:
        sht.Visible = -1
    sht.Activate()

    if was_hidden:
        _last_auto_unhidden["path"] = target_norm
        _last_auto_unhidden["sheet"] = sheet_name

    try:
        sht.ClearArrows()
    except Exception:
        pass
    if precedent_cells:
        for addr in precedent_cells:
            try:
                sht.Range(addr).ShowPrecedents()
            except Exception:
                pass
    if dependent_cells:
        for addr in dependent_cells:
            try:
                sht.Range(addr).ShowDependents()
            except Exception:
                pass

    try:
        hwnd = wb.Windows(1).Hwnd

        win32api.keybd_event(win32con.VK_MENU, 0, 0, 0)
        win32api.keybd_event(win32con.VK_MENU, 0, win32con.KEYEVENTF_KEYUP, 0)

        fg_hwnd = win32gui.GetForegroundWindow()
        fg_thread = win32process.GetWindowThreadProcessId(fg_hwnd)[0]
        target_thread = win32process.GetWindowThreadProcessId(hwnd)[0]
        current_thread = win32api.GetCurrentThreadId()

        win32process.AttachThreadInput(fg_thread, current_thread, True)
        win32process.AttachThreadInput(target_thread, current_thread, True)
        try:
            win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
            win32gui.BringWindowToTop(hwnd)
            win32gui.SetForegroundWindow(hwnd)
        finally:
            win32process.AttachThreadInput(fg_thread, current_thread, False)
            win32process.AttachThreadInput(target_thread, current_thread, False)
    except Exception:
        pass


