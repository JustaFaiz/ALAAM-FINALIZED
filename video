from moviepy import VideoFileClip, concatenate_videoclips, vfx

clips_dict = {
    "video1.mp4": [(10, 25), (40, 55)],   # important segments to keep normal speed
    "video2.mp4": [(5, 20)],
    "video3.mp4": [(0, 12), (30, 45)]
}

FAST_FORWARD_SPEED = 4   # how much to speed up unimportant parts

final_segments = []

for filepath, important_ranges in clips_dict.items():
    video = VideoFileClip(filepath)
    duration = video.duration

    # sort timestamps just in case they're out of order
    important_ranges = sorted(important_ranges, key=lambda x: x[0])

    # build a full list of (start, end, is_important) segments covering 0 -> duration
    segments = []
    cursor = 0.0

    for start, end in important_ranges:
        if start > cursor:
            segments.append((cursor, start, False))   # unimportant gap before this segment
        segments.append((start, end, True))            # important segment
        cursor = end

    if cursor < duration:
        segments.append((cursor, duration, False))     # trailing unimportant part

    # build actual clips from segments
    for start, end, is_important in segments:
        if end - start <= 0:
            continue  # skip zero-length segments
        sub = video.subclipped(start, end)
        if not is_important:
            sub = sub.with_effects([vfx.MultiplySpeed(FAST_FORWARD_SPEED)])
        final_segments.append(sub)

# concatenate everything, in order, nothing skipped
final_video = concatenate_videoclips(final_segments, method="compose")
final_video.write_videofile("output.mp4", codec="libx264", audio_codec="aac")

for seg in final_segments:
    seg.close()
final_video.close()
