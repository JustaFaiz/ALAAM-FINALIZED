"""
sheet_tree_server.py
----------------------
Interactive tree of sheet-to-sheet data flow. Clicking a sheet box
ACTUALLY switches to that sheet in Excel - a plain browser link can't
do this reliably (browsers strip the sheet info when handing a file
off to Excel), so this runs a small local server that uses pywin32
(COM automation - the same mechanism VBA macros use) to control Excel
directly. No Excel add-in required.

Requires:
    pip install openpyxl pywin32
    Excel must be installed (this drives the real Excel application).

Usage:
    python sheet_tree_server.py workbook.xlsx
    python sheet_tree_server.py workbook.xlsx 5      (only show links with 5+ cells)

This opens the tree in your browser automatically and starts a local
server. Leave the terminal window open while you use it - closing it
(Ctrl+C) stops the server. Clicking a sheet box brings Excel to the
front and switches to that sheet.
"""

import json
import os
import re
import sys
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs

from openpyxl import load_workbook
from openpyxl.utils import range_boundaries, get_column_letter, column_index_from_string

DEFAULT_FILE = r"C:\Users\Mohamed.Faiz\Downloads\python stuff\FRB7_WKPR_2024.xlsx"
DEFAULT_MIN_CELLS = 3
PORT = 8765

CELL_REF_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])(\$?[A-Z]{1,3}\$?\d{1,7})(?::(\$?[A-Z]{1,3}\$?\d{1,7}))?(?!\()"
)
COLUMN_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?([A-Z]{1,3})\$?:\$?([A-Z]{1,3})\$?(?![A-Za-z0-9_])"
)
ROW_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?(\d{1,7})\$?:\$?(\d{1,7})\$?(?![A-Za-z0-9_])"
)

FULL_RANGE_ROW_CAP = 5000
FULL_RANGE_COL_CAP = 200


def _spans_overlap(span, other_spans):
    s0, s1 = span
    for a0, a1 in other_spans:
        if s0 < a1 and a0 < s1:
            return True
    return False


def extract_refs(formula, current_sheet, sheet_bounds):
    refs = []
    matched_spans = []

    for m in CELL_REF_RE.finditer(formula):
        matched_spans.append(m.span())
        sheet = m.group(1) or m.group(2) or current_sheet
        cell1 = m.group(3).replace('$', '')
        cell2 = m.group(4)
        if cell2:
            cell2 = cell2.replace('$', '')
            try:
                min_col, min_row, max_col, max_row = range_boundaries(f"{cell1}:{cell2}")
                for r in range(min_row, max_row + 1):
                    for c in range(min_col, max_col + 1):
                        refs.append((sheet, f"{get_column_letter(c)}{r}"))
            except Exception:
                continue
        else:
            refs.append((sheet, cell1))

    for m in COLUMN_ONLY_RE.finditer(formula):
        if _spans_overlap(m.span(), matched_spans):
            continue
        sheet = m.group(1) or m.group(2) or current_sheet
        col1, col2 = m.group(3), m.group(4)
        c1, c2 = column_index_from_string(col1), column_index_from_string(col2)
        if c1 > c2:
            c1, c2 = c2, c1
        max_row = min(sheet_bounds.get(sheet, (FULL_RANGE_ROW_CAP, 1))[0], FULL_RANGE_ROW_CAP) or 1
        for c in range(c1, c2 + 1):
            col_letter = get_column_letter(c)
            for r in range(1, max_row + 1):
                refs.append((sheet, f"{col_letter}{r}"))

    for m in ROW_ONLY_RE.finditer(formula):
        if _spans_overlap(m.span(), matched_spans):
            continue
        sheet = m.group(1) or m.group(2) or current_sheet
        row1, row2 = int(m.group(3)), int(m.group(4))
        if row1 > row2:
            row1, row2 = row2, row1
        max_col = min(sheet_bounds.get(sheet, (1, FULL_RANGE_COL_CAP))[1], FULL_RANGE_COL_CAP) or 1
        for r in range(row1, row2 + 1):
            for c in range(1, max_col + 1):
                refs.append((sheet, f"{get_column_letter(c)}{r}"))

    return refs


def load_formulas(path):
    wb = load_workbook(path, data_only=False)
    formulas = {}
    sheet_bounds = {}
    for ws in wb.worksheets:
        sheet_bounds[ws.title] = (ws.max_row or 1, ws.max_column or 1)
        for row in ws.iter_rows():
            for cell in row:
                if isinstance(cell.value, str) and cell.value.startswith('='):
                    formulas[(ws.title, cell.coordinate)] = cell.value
    return formulas, wb, sheet_bounds


def build_sheet_flow(formulas, sheet_bounds):
    flow = {}
    for (sheet, cell), f in formulas.items():
        refs = extract_refs(f, sheet, sheet_bounds)
        source_sheets = set(s for s, c in refs)
        for src in source_sheets:
            if src == sheet:
                continue
            key = (src, sheet)
            flow[key] = flow.get(key, 0) + 1
    return flow


def open_sheet_in_excel(workbook_path, sheet_name):
    """Uses pywin32 COM automation to actually drive Excel - no add-in
    required, this is the same mechanism VBA macros use. Grabs an
    already-running Excel instance if one has this workbook open;
    otherwise starts Excel and opens it fresh."""
    import win32com.client as win32
    import pywintypes
    import win32gui
    import win32process
    import win32api
    import win32con

    def norm(p):
        return os.path.normcase(os.path.normpath(p))

    abs_path = os.path.abspath(workbook_path)
    target_norm = norm(abs_path)
    target_base = os.path.basename(abs_path).lower()

    excel = None
    wb = None

    try:
        excel = win32.GetActiveObject("Excel.Application")
    except pywintypes.com_error:
        excel = None

    if excel is not None:
        # First pass: exact normalized path match
        for book in excel.Workbooks:
            try:
                if norm(book.FullName) == target_norm:
                    wb = book
                    break
            except Exception:
                continue
        # Fallback: match by filename only, in case of drive-letter /
        # UNC-path formatting differences
        if wb is None:
            for book in excel.Workbooks:
                try:
                    if book.Name.lower() == target_base:
                        wb = book
                        break
                except Exception:
                    continue

    if excel is None:
        excel = win32.Dispatch("Excel.Application")

    excel.Visible = True
    excel.DisplayAlerts = False       # don't block on "already open, reopen?" prompts
    try:
        excel.AskToUpdateLinks = False  # don't block on external-link update prompts
    except Exception:
        pass

    if wb is None:
        # UpdateLinks=0 tells Excel not to prompt about external links at all
        wb = excel.Workbooks.Open(abs_path, 0)

    wb.Activate()

    sht = wb.Sheets(sheet_name)
    if sht.Visible != -1:      # -1 = xlSheetVisible; hidden sheets can't be Activate()'d directly
        sht.Visible = -1
    sht.Activate()

    # Force real foreground focus on THIS workbook's own window specifically
    # (not just "an Excel window" - with multiple workbooks open, the
    # Application-level handle can point at the wrong one). Windows
    # normally blocks background processes from stealing focus, so
    # Visible=True alone isn't enough - this attaches our input thread
    # to the target window's thread just long enough to legitimately
    # claim focus.
    try:
        hwnd = wb.Windows(1).Hwnd
        fg_hwnd = win32gui.GetForegroundWindow()
        fg_thread = win32process.GetWindowThreadProcessId(fg_hwnd)[0]
        target_thread = win32process.GetWindowThreadProcessId(hwnd)[0]
        current_thread = win32api.GetCurrentThreadId()

        win32process.AttachThreadInput(target_thread, current_thread, True)
        try:
            win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
            win32gui.SetForegroundWindow(hwnd)
        finally:
            win32process.AttachThreadInput(target_thread, current_thread, False)
    except Exception:
        pass


